# Copy to .env and fill in what you need. Everything is optional: with nothing set, FilingLens
# runs offline with the fixture corpus, the hashing embedder and the demo model (not an AI).

# Chat model: any OpenAI-compatible endpoint, e.g. the LLM Gateway or https://api.openai.com/v1
FILINGLENS_LLM_BASE_URL=
FILINGLENS_LLM_API_KEY=
FILINGLENS_LLM_MODEL=gpt-4o-mini
# Used by the router for the final answer to hard questions
FILINGLENS_LLM_STRONG_MODEL=

# Embeddings: an OpenAI-compatible /embeddings endpoint. Changing the dimension needs a fresh
# database (the pgvector column has a fixed size).
FILINGLENS_EMBEDDINGS_BASE_URL=
FILINGLENS_EMBEDDINGS_MODEL=text-embedding-3-small
FILINGLENS_EMBEDDING_DIM=256

# Required to ingest real filings from SEC EDGAR: a name and a contact email
FILINGLENS_EDGAR_USER_AGENT=

# MCP agent transport: stdio | http | direct
FILINGLENS_MCP_TRANSPORT=stdio
FILINGLENS_MCP_URL=

# Requests per minute per client IP (0 = off)
FILINGLENS_RATE_LIMIT_ASK=30
FILINGLENS_RATE_LIMIT_INGEST=5
